              [Sched_Go, Sched_Go, Sched_Go, Sched_Crash] cw_lag_w"
    by (rule dwk_protocol_run.run_go[OF pn3 pm4 s4])
  have s2: "dwk_protocol_run pr2_w
              [Sched_Go, Sched_Go, Sched_Go, Sched_Go, Sched_Crash] cw_lag_w"
    by (rule dwk_protocol_run.run_go[OF pn2 pm3 s3])
  have s1: "dwk_protocol_run pr1_w
              [Sched_Go, Sched_Go, Sched_Go, Sched_Go, Sched_Go, Sched_Crash]
              cw_lag_w"
    by (rule dwk_protocol_run.run_go[OF pn1 pm2 s2])
