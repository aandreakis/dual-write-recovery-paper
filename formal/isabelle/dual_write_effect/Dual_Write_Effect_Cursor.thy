section \<open>The durable-local view and the measured policy class\<close>

text \<open>
  The view record collects exactly what a post-crash recovery of this
  consumer reads without querying the sink side: base map, committed
  source WAL, enqueue log, ack log, scope, finish frontier, run status,
  recovery epoch, and the progress cursor.  Excluded, per the design
  preamble: the emission ledger (external), the downstream store content
  (sink-side delivered material --- reading it is the escape, priced
  below), and the volatile in-flight window.
\<close>

record ('k, 'v) dwk_local_view =
  lv_base   :: "'k \<rightharpoonup> 'v"
  lv_src    :: "('k, 'v) src_history"
  lv_enq    :: "('k, 'v) src_history"
  lv_ack    :: "('k, 'v) src_history"
  lv_scope  :: "'k set"
  lv_finish :: frontier
  lv_status :: dw_run_status
  lv_epoch  :: nat
  lv_cursor :: nat

definition durable_local_view
  :: "('k, 'v) dwk_state \<Rightarrow> ('k, 'v) dwk_local_view"
where
  "durable_local_view T =
     \<lparr> lv_base = exec_base (dwe_core (dwk_base T)),
       lv_src = exec_src_hist (dwe_core (dwk_base T)),
       lv_enq = exec_enqueued (dwe_core (dwk_base T)),
       lv_ack = exec_acked (dwe_core (dwk_base T)),
       lv_scope = exec_scope (dwe_core (dwk_base T)),
       lv_finish = exec_finish (dwe_core (dwk_base T)),
       lv_status = exec_status (dwe_core (dwk_base T)),
       lv_epoch = dwe_epoch (dwk_base T),
       lv_cursor = dwk_cursor T \<rparr>"

text \<open>THE PAIR IS EQUAL ON THE ENTIRE DURABLE-LOCAL VIEW --- the cursor
  included --- while the ledgers differ.\<close>

lemma pair_views_equal:
  "durable_local_view cw_del_w = durable_local_view cw_lag_w"
  by (simp add: durable_local_view_def cw_del_w_def cw_lag_w_def
                dp_crash_w_def t_mid_w_def mkW_def mkT_def mkC_def)

lemma pair_cursors_equal: "dwk_cursor cw_del_w = dwk_cursor cw_lag_w"
  by (simp add: cw_del_fields cw_lag_fields)

text \<open>
  Policies and the measured class, pinned at the witness instantiation
  like the landed policy classes.  @{text durable_local_measured}: the
  policy's batch factors through the durable-local view --- this
  subsumes in particular every recovery rule reading the durable cursor,
  the committed source, and the outbox log.  @{text view_blind} is the
  agreement form; the iff below is the analogue of the landed
  ledger-blindness bridge, via a canonical state builder.
\<close>

type_synonym dwk_redrive_policy =
  "(nat, nat) dwk_state \<Rightarrow> (src_coord \<times> (nat, nat) source_event) list"

definition durable_local_measured :: "dwk_redrive_policy \<Rightarrow> bool" where
  "durable_local_measured P \<longleftrightarrow>
     (\<exists>g. \<forall>T. P T = g (durable_local_view T))"

definition view_blind :: "dwk_redrive_policy \<Rightarrow> bool" where
  "view_blind P \<longleftrightarrow>
     (\<forall>T U. durable_local_view T = durable_local_view U \<longrightarrow> P T = P U)"

definition state_of_view
  :: "('k, 'v) dwk_local_view \<Rightarrow> ('k, 'v) dwk_state"
where
  "state_of_view v =
     \<lparr> dwk_base =
         \<lparr> dwe_core =
             \<lparr> exec_base = lv_base v,
               exec_src_hist = lv_src v,
               exec_down_hist = [],
               exec_enqueued = lv_enq v,
               exec_pending = {},
               exec_scope = lv_scope v,
               exec_finish = lv_finish v,
               exec_status = lv_status v,
               exec_acked = lv_ack v \<rparr>,
           dwe_emitted = [],
           dwe_epoch = lv_epoch v \<rparr>,
       dwk_cursor = lv_cursor v \<rparr>"

lemma view_of_state_of_view [simp]:
  "durable_local_view (state_of_view v) = v"
  by (rule dwk_local_view.equality)
     (simp_all add: durable_local_view_def state_of_view_def)

theorem view_blind_iff_durable_local_measured:
  "view_blind P \<longleftrightarrow> durable_local_measured P"
proof
  assume vb: "view_blind P"
  define g where "g = (\<lambda>v. P (state_of_view v))"
  have "\<forall>T. P T = g (durable_local_view T)"
  proof
    fix T :: "(nat, nat) dwk_state"
    have "P T = P (state_of_view (durable_local_view T))"
      by (rule vb[unfolded view_blind_def, rule_format]) simp
    then show "P T = g (durable_local_view T)"
      by (simp add: g_def)
  qed
  then show "durable_local_measured P"
    unfolding durable_local_measured_def by blast
next
  assume "durable_local_measured P"
  then obtain g where g: "\<forall>T. P T = g (durable_local_view T)"
    unfolding durable_local_measured_def by blast
  show "view_blind P"
    unfolding view_blind_def
  proof (intro allI impI)
    fix T U :: "(nat, nat) dwk_state"
    assume "durable_local_view T = durable_local_view U"
    then show "P T = P U" using g by metis
  qed
qed

text \<open>
  Full-state extensionality: the durable-local view plus the three
  excluded components determine the state.  This is the formal carrier
  of the carve's completeness --- there is no fourth hidden component ---
  and the dichotomy's engine.
\<close>

lemma dwk_state_view_ext:
  fixes T U :: "('k, 'v) dwk_state"
  assumes "durable_local_view T = durable_local_view U"
      and "exec_down_hist (dwe_core (dwk_base T))
             = exec_down_hist (dwe_core (dwk_base U))"
      and "exec_pending (dwe_core (dwk_base T))
             = exec_pending (dwe_core (dwk_base U))"
      and "dwe_emitted (dwk_base T) = dwe_emitted (dwk_base U)"
  shows "T = U"
proof -
  have vc:
    "exec_base (dwe_core (dwk_base T)) = exec_base (dwe_core (dwk_base U))
   \<and> exec_src_hist (dwe_core (dwk_base T))
       = exec_src_hist (dwe_core (dwk_base U))
   \<and> exec_enqueued (dwe_core (dwk_base T))
       = exec_enqueued (dwe_core (dwk_base U))
   \<and> exec_acked (dwe_core (dwk_base T)) = exec_acked (dwe_core (dwk_base U))
   \<and> exec_scope (dwe_core (dwk_base T)) = exec_scope (dwe_core (dwk_base U))
   \<and> exec_finish (dwe_core (dwk_base T)) = exec_finish (dwe_core (dwk_base U))
   \<and> exec_status (dwe_core (dwk_base T)) = exec_status (dwe_core (dwk_base U))
   \<and> dwe_epoch (dwk_base T) = dwe_epoch (dwk_base U)
   \<and> dwk_cursor T = dwk_cursor U"
    using assms(1) unfolding durable_local_view_def by simp
  have core: "dwe_core (dwk_base T) = dwe_core (dwk_base U)"
    using vc assms(2,3) by (intro dw_exec_state.equality) simp_all
  have base: "dwk_base T = dwk_base U"
    using core assms(4) vc by (intro dwe_state.equality) simp_all
  show ?thesis
    using base vc by (intro dwk_state.equality) simp_all
qed

section \<open>Re-drive policies on the cursor machine\<close>

text \<open>
  The recovery model is the landed policy redrive, lifted: the policy
  reads the WRAPPER state (so it may read the cursor), its batch is
  handed to the landed base-level redrive, and the cursor is untouched
  by recovery (recovery may re-read it; advancing it is the persist
  transition's job).  All landed generic redrive facts transfer through
  the base conjunct.
\<close>

definition dwk_policy_redrive
  :: "dwk_redrive_policy \<Rightarrow> (nat, nat) dwk_state \<Rightarrow> frontier
      \<Rightarrow> (nat, nat) dwk_state \<Rightarrow> bool"
where
  "dwk_policy_redrive P T f T' \<longleftrightarrow>
     policy_redrive (\<lambda>_. P T) (dwk_base T) f (dwk_base T')
   \<and> dwk_cursor T' = dwk_cursor T"

definition dwk_redrive_result
  :: "dwk_redrive_policy \<Rightarrow> (nat, nat) dwk_state \<Rightarrow> frontier
      \<Rightarrow> (nat, nat) dwk_state"
where
  "dwk_redrive_result P T f =
     mkW (redrive_result (\<lambda>_. P T) (dwk_base T) f) (dwk_cursor T)"

lemma dwk_policy_redriveI:
  assumes "\<exists>c. exec_status (dwe_core (dwk_base T)) = Crashed c"
      and "f \<le> exec_finish (dwe_core (dwk_base T))"
  shows "dwk_policy_redrive P T f (dwk_redrive_result P T f)"
  unfolding dwk_policy_redrive_def dwk_redrive_result_def
  using policy_redriveI[OF assms] by simp

lemma dwk_policy_redrive_base:
  assumes "dwk_policy_redrive P T f T'"
  shows "policy_redrive (\<lambda>_. P T) (dwk_base T) f (dwk_base T')"
  using assms by (simp add: dwk_policy_redrive_def)

lemma dwk_policy_redrive_unique:
  assumes "dwk_policy_redrive P T f T'"
  shows "T' = dwk_redrive_result P T f"
proof -
  have base: "dwk_base T' = redrive_result (\<lambda>_. P T) (dwk_base T) f"
    by (rule policy_redrive_result[OF dwk_policy_redrive_base[OF assms]])
  have cur: "dwk_cursor T' = dwk_cursor T"
    using assms by (simp add: dwk_policy_redrive_def)
  show ?thesis
    using base cur
    by (intro dwk_state.equality) (simp_all add: dwk_redrive_result_def)
qed

lemma dwk_policy_redrive_heals:
  assumes "dwk_policy_redrive P T f T'"
  shows "\<forall>k. \<not> mismatch_at (proto_of_exec_at (dwe_core (dwk_base T')) f) f k"
  by (rule policy_redrive_heals[OF dwk_policy_redrive_base[OF assms]])

text \<open>Batch congruence for the base redrive: the landed relation
  evaluates its policy only at the pre-state.\<close>

lemma policy_redrive_batch_cong:
  assumes "P t = Q t"
  shows "policy_redrive P t f t' \<longleftrightarrow> policy_redrive Q t f t'"
  by (simp add: policy_redrive_def assms)

section \<open>THE KERNEL: batch agreement on the window pair defeats\<close>

text \<open>
  The exported kernel, in the landed batch-agreement shape at the
  protocol-generated pair: every policy that emits the same batch on
  both members is defeated --- its own redrive heals every scoped store
  mismatch at the frontier on both members, yet the batch either
  duplicates or goes premature on the delivered member, or loses the
  committed second effect on the lag member.  The three total cases
  mirror the landed kernel's proof: an empty batch loses on the lag
  side; a batch touching an already-delivered payload duplicates on the
  delivered side; a non-empty alien batch is premature on the delivered
  side (stamped at the full committed prefix, payload outside it).
  Loss is a horn, not a premise: refusing to emit lands in the first
  case.
\<close>

theorem window_pair_batch_agreement_defeated:
  fixes P :: dwk_redrive_policy
  assumes PB: "P cw_del_w = P cw_lag_w"
  shows "\<exists>T1' T2'.
           dwk_policy_redrive P cw_del_w ec2 T1'
         \<and> dwk_policy_redrive P cw_lag_w ec2 T2'
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
         \<and> (effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2'))"
proof -
  define B where "B = P cw_del_w"

  have grd1: "\<exists>c. exec_status (dwe_core (dwk_base cw_del_w)) = Crashed c"
    by (simp add: cw_del_fields)
  have grd2: "\<exists>c. exec_status (dwe_core (dwk_base cw_lag_w)) = Crashed c"
    by (simp add: cw_lag_fields)
  have fin1: "ec2 \<le> exec_finish (dwe_core (dwk_base cw_del_w))"
    by (simp add: cw_del_fields)
  have fin2: "ec2 \<le> exec_finish (dwe_core (dwk_base cw_lag_w))"
    by (simp add: cw_lag_fields)

  define T1' where "T1' = dwk_redrive_result P cw_del_w ec2"
  define T2' where "T2' = dwk_redrive_result P cw_lag_w ec2"
  have pr1: "dwk_policy_redrive P cw_del_w ec2 T1'"
    unfolding T1'_def by (rule dwk_policy_redriveI[OF grd1 fin1])
  have pr2: "dwk_policy_redrive P cw_lag_w ec2 T2'"
    unfolding T2'_def by (rule dwk_policy_redriveI[OF grd2 fin2])

  have base1: "dwk_base T1' = redrive_result (\<lambda>_. B) (dwk_base cw_del_w) ec2"
    unfolding T1'_def dwk_redrive_result_def B_def by simp
  have base2:
    "dwk_base T2' = redrive_result (\<lambda>_. P cw_lag_w) (dwk_base cw_lag_w) ec2"
    unfolding T2'_def dwk_redrive_result_def by simp

  have em1: "dwe_emitted (dwk_base T1')
      = [(1, 0, ec1, e1), (2, 0, ec2, e2)] @ map (\<lambda>(c, e). (2, 0, c, e)) B"
    unfolding base1 redrive_result_def
    by (simp add: cw_del_w_def dp_crash_w_def mkW_def mkT_def mkC_def
                  eval_nat_numeral)
  have em2: "dwe_emitted (dwk_base T2')
      = [(1, 0, ec1, e1)] @ map (\<lambda>(c, e). (2, 0, c, e)) (P cw_lag_w)"
    unfolding base2 redrive_result_def
    by (simp add: cw_lag_w_def t_mid_w_def mkW_def mkT_def mkC_def
                  eval_nat_numeral)
  have src1: "exec_src_hist (dwe_core (dwk_base T1')) = [(ec1, e1), (ec2, e2)]"
    unfolding base1 redrive_result_def
    by (simp add: cw_del_w_def dp_crash_w_def mkW_def mkT_def mkC_def)
  have src2: "exec_src_hist (dwe_core (dwk_base T2')) = [(ec1, e1), (ec2, e2)]"
    unfolding base2 redrive_result_def
    by (simp add: cw_lag_w_def t_mid_w_def mkW_def mkT_def mkC_def)
  have scope2: "exec_scope (dwe_core (dwk_base T2')) = {0, 1}"
    unfolding base2 redrive_result_def
    by (simp add: cw_lag_w_def t_mid_w_def mkW_def mkT_def mkC_def)

  have pay1: "map e_payload (dwe_emitted (dwk_base T1'))
                = [(ec1, e1), (ec2, e2)] @ B"
    by (simp add: em1)

  have horn: "effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2')"
  proof (cases "B = []")
    case True
    \<comment> \<open>(i) the policy refuses to emit: the lag member LOSES effect 2\<close>
    have P2: "P cw_lag_w = []"
      using PB True unfolding B_def by simp
    have em2': "dwe_emitted (dwk_base T2') = [(1, 0, ec1, e1)]"
      using em2 by (simp add: P2)
    have inrep: "(ec2, e2) \<in> set (replay_down_hist
                    (exec_src_hist (dwe_core (dwk_base T2')))
                    (exec_scope (dwe_core (dwk_base T2'))) ec2)"
      by (simp add: src2 scope2 replay_down_hist_def e1_def e2_def ec_defs
                    eval_nat_numeral)
    have notin: "(ec2, e2) \<notin> e_payload ` set (dwe_emitted (dwk_base T2'))"
      by (simp add: em2' e1_def e2_def ec_defs)
    have "lost_effect ec2 (dwk_base T2')"
      unfolding lost_effect_def using inrep notin by blast
    then show ?thesis ..
  next
    case False
    then obtain p0 where p0: "p0 \<in> set B"
      by (cases B) auto
    show ?thesis
    proof (cases "\<exists>p \<in> set B. p \<in> {(ec1, e1), (ec2, e2)}")
      case True
      \<comment> \<open>(ii) the batch re-fires an already-delivered payload: DUPLICATE
          on the delivered member\<close>
      have "\<not> distinct (map e_payload (dwe_emitted (dwk_base T1')))"
        unfolding pay1 using True by auto
      then have "effect_unsafe (dwk_base T1')"
        by (simp add: effect_unsafe_def duplicate_def)
      then show ?thesis ..
    next
      case False
      \<comment> \<open>(iii) a non-empty alien batch: stamped at the full prefix but
          outside it --- PREMATURE on the delivered member\<close>
      have p0_out: "p0 \<notin> {(ec1, e1), (ec2, e2)}"
        using False p0 by blast
      obtain c e where p_eq: "p0 = (c, e)" by (cases p0)
      have x_in: "(2, 0, c, e) \<in> set (dwe_emitted (dwk_base T1'))"
        using p0 p_eq by (force simp: em1)
      have "\<not> justified_at (exec_src_hist (dwe_core (dwk_base T1'))) (2, 0, c, e)"
        using p0_out p_eq
        by (simp add: justified_at_def src1 eval_nat_numeral)
      then have "premature (dwk_base T1')"
        unfolding premature_def using x_in by blast
      then have "effect_unsafe (dwk_base T1')"
        by (simp add: effect_unsafe_def)
      then show ?thesis ..
    qed
  qed

  have heal1: "\<forall>k. \<not> mismatch_at
                 (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k"
    by (rule dwk_policy_redrive_heals[OF pr1])
  have heal2: "\<forall>k. \<not> mismatch_at
                 (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k"
    by (rule dwk_policy_redrive_heals[OF pr2])

  show ?thesis using pr1 pr2 heal1 heal2 horn by blast
qed

section \<open>THE HEADLINE: the same-protocol checkpoint dilemma\<close>

text \<open>
  House polarity: exhibit the pair --- both members generated by the ONE
  deterministic protocol from the pinned initial state, under the two
  crash schedules whose only difference is where the crash lands ---
  then defeat every policy that cannot distinguish its members.  The
  view-equality conjunct carries the whole durable-local view; the
  cursor conjunct restates its cursor component explicitly, because the
  cursor is the point of the objection this theorem answers.
\<close>

theorem same_protocol_batch_agreement_dilemma:
  "\<exists>T1 T2.
     dwk_protocol_run (dwk_init Map.empty {0, 1} ec2) sched_deliver T1
   \<and> dwk_protocol_run (dwk_init Map.empty {0, 1} ec2) sched_lag T2
   \<and> dwk_reachable T1 \<and> dwk_reachable T2
   \<and> durable_local_view T1 = durable_local_view T2
   \<and> dwk_cursor T1 = dwk_cursor T2
   \<and> dwe_emitted (dwk_base T1) \<noteq> dwe_emitted (dwk_base T2)
   \<and> \<not> effect_unsafe (dwk_base T1) \<and> \<not> effect_unsafe (dwk_base T2)
   \<and> genuinely_emitting (dwk_base T1) \<and> genuinely_emitting (dwk_base T2)
   \<and> (\<forall>P. P T1 = P T2 \<longrightarrow>
        (\<exists>T1' T2'.
           dwk_policy_redrive P T1 ec2 T1'
         \<and> dwk_policy_redrive P T2 ec2 T2'
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
         \<and> (effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2'))))"
proof -
  have inner: "\<forall>P. P cw_del_w = P cw_lag_w \<longrightarrow>
        (\<exists>T1' T2'.
           dwk_policy_redrive P cw_del_w ec2 T1'
         \<and> dwk_policy_redrive P cw_lag_w ec2 T2'
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
         \<and> (effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2')))"
    using window_pair_batch_agreement_defeated by blast
  show ?thesis
    using protocol_run_deliver protocol_run_lag reach_cw_del reach_cw_lag
          pair_views_equal pair_cursors_equal pair_ledgers_differ
          cw_del_safe cw_lag_safe cw_del_emitting cw_lag_emitting inner
    by blast
qed

text \<open>
  The class defeat, exists-pair form: ONE protocol-generated pair
  defeats ALL durable-local-measured policies --- every recovery whose
  batch is a function of the durable-local view, the durable cursor
  included.
\<close>

theorem checkpoint_dilemma_pair:
  "\<exists>T1 T2.
     dwk_reachable T1 \<and> dwk_reachable T2
   \<and> durable_local_view T1 = durable_local_view T2
   \<and> dwk_cursor T1 = dwk_cursor T2
   \<and> dwe_emitted (dwk_base T1) \<noteq> dwe_emitted (dwk_base T2)
   \<and> \<not> effect_unsafe (dwk_base T1) \<and> \<not> effect_unsafe (dwk_base T2)
   \<and> genuinely_emitting (dwk_base T1) \<and> genuinely_emitting (dwk_base T2)
   \<and> (\<forall>P. durable_local_measured P \<longrightarrow>
        (\<exists>T1' T2'.
           dwk_policy_redrive P T1 ec2 T1'
         \<and> dwk_policy_redrive P T2 ec2 T2'
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
         \<and> (effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2'))))"
proof -
  have sm: "\<forall>P. durable_local_measured P \<longrightarrow>
        (\<exists>T1' T2'.
           dwk_policy_redrive P cw_del_w ec2 T1'
         \<and> dwk_policy_redrive P cw_lag_w ec2 T2'
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
         \<and> (effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2')))"
  proof (intro allI impI)
    fix P :: dwk_redrive_policy
    assume "durable_local_measured P"
    then obtain g where "\<forall>T. P T = g (durable_local_view T)"
      unfolding durable_local_measured_def by blast
    then have "P cw_del_w = P cw_lag_w"
      using pair_views_equal by metis
    then show "\<exists>T1' T2'.
           dwk_policy_redrive P cw_del_w ec2 T1'
         \<and> dwk_policy_redrive P cw_lag_w ec2 T2'
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
         \<and> (effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2'))"
      by (rule window_pair_batch_agreement_defeated)
  qed
  show ?thesis
    using reach_cw_del reach_cw_lag pair_views_equal pair_cursors_equal
          pair_ledgers_differ cw_del_safe cw_lag_safe cw_del_emitting
          cw_lag_emitting sm
    by blast
qed

text \<open>The quantifier-reordered form, mirroring the landed audited
  statement shape.\<close>

theorem checkpoint_dilemma:
  "\<forall>P. durable_local_measured P \<longrightarrow>
     (\<exists>T1 T2 T1' T2'.
        dwk_reachable T1 \<and> dwk_reachable T2
      \<and> durable_local_view T1 = durable_local_view T2
      \<and> dwk_cursor T1 = dwk_cursor T2
      \<and> dwe_emitted (dwk_base T1) \<noteq> dwe_emitted (dwk_base T2)
      \<and> \<not> effect_unsafe (dwk_base T1) \<and> \<not> effect_unsafe (dwk_base T2)
      \<and> genuinely_emitting (dwk_base T1) \<and> genuinely_emitting (dwk_base T2)
      \<and> dwk_policy_redrive P T1 ec2 T1'
      \<and> dwk_policy_redrive P T2 ec2 T2'
      \<and> (\<forall>k. \<not> mismatch_at
                 (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
      \<and> (\<forall>k. \<not> mismatch_at
                 (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
      \<and> (effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2')))"
proof (intro allI impI)
  fix P :: dwk_redrive_policy
  assume sm: "durable_local_measured P"
  obtain g where "\<forall>T. P T = g (durable_local_view T)"
    using sm unfolding durable_local_measured_def by blast
  then have agree: "P cw_del_w = P cw_lag_w"
    using pair_views_equal by metis
  obtain T1' T2' where
    prim: "dwk_policy_redrive P cw_del_w ec2 T1'"
          "dwk_policy_redrive P cw_lag_w ec2 T2'"
          "\<forall>k. \<not> mismatch_at
                  (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k"
          "\<forall>k. \<not> mismatch_at
                  (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k"
          "effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2')"
    using window_pair_batch_agreement_defeated[OF agree] by blast
  show "\<exists>T1 T2 T1' T2'.
        dwk_reachable T1 \<and> dwk_reachable T2
      \<and> durable_local_view T1 = durable_local_view T2
      \<and> dwk_cursor T1 = dwk_cursor T2
      \<and> dwe_emitted (dwk_base T1) \<noteq> dwe_emitted (dwk_base T2)
      \<and> \<not> effect_unsafe (dwk_base T1) \<and> \<not> effect_unsafe (dwk_base T2)
      \<and> genuinely_emitting (dwk_base T1) \<and> genuinely_emitting (dwk_base T2)
      \<and> dwk_policy_redrive P T1 ec2 T1'
      \<and> dwk_policy_redrive P T2 ec2 T2'
      \<and> (\<forall>k. \<not> mismatch_at
                 (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
      \<and> (\<forall>k. \<not> mismatch_at
                 (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
      \<and> (effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2'))"
    using reach_cw_del reach_cw_lag pair_views_equal pair_cursors_equal
          pair_ledgers_differ cw_del_safe cw_lag_safe cw_del_emitting
          cw_lag_emitting prim
    by blast
qed

section \<open>The two-horn sharpening at the window pair: duplicate or leave owed\<close>

text \<open>
  The landed-kernel sharpening
  (@{thm [source] pair_batch_agreement_duplicate_or_lost}), replayed at
  the protocol-generated window pair: the shared batch either re-fires
  an already-delivered payload of the delivered member --- that member's
  redrive DUPLICATES --- or it contains no delivered payload at all, and
  then it never covers the committed second effect either (that effect,
  @{term "(ec2, e2)"}, IS a delivered payload of the delivered member),
  so the lag member stays OWED.  The kernel's empty-batch and
  alien-batch cases both land in loss; going premature is no escape
  from the pair's accounting.  Same redrives, same heal conjuncts as
  @{thm [source] window_pair_batch_agreement_defeated}; only the defeat
  disjunct sharpens.  Facts of the window pair, exists-system polarity.
\<close>

theorem window_pair_duplicate_or_lost:
  fixes P :: dwk_redrive_policy
  assumes PB: "P cw_del_w = P cw_lag_w"
  shows "\<exists>T1' T2'.
           dwk_policy_redrive P cw_del_w ec2 T1'
         \<and> dwk_policy_redrive P cw_lag_w ec2 T2'
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
         \<and> (duplicate (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2'))"
proof -
  define B where "B = P cw_del_w"
  have PB2: "P cw_lag_w = B"
    using PB unfolding B_def by simp

  have grd1: "\<exists>c. exec_status (dwe_core (dwk_base cw_del_w)) = Crashed c"
    by (simp add: cw_del_fields)
  have grd2: "\<exists>c. exec_status (dwe_core (dwk_base cw_lag_w)) = Crashed c"
    by (simp add: cw_lag_fields)
  have fin1: "ec2 \<le> exec_finish (dwe_core (dwk_base cw_del_w))"
    by (simp add: cw_del_fields)
  have fin2: "ec2 \<le> exec_finish (dwe_core (dwk_base cw_lag_w))"
    by (simp add: cw_lag_fields)

  define T1' where "T1' = dwk_redrive_result P cw_del_w ec2"
  define T2' where "T2' = dwk_redrive_result P cw_lag_w ec2"
  have pr1: "dwk_policy_redrive P cw_del_w ec2 T1'"
    unfolding T1'_def by (rule dwk_policy_redriveI[OF grd1 fin1])
  have pr2: "dwk_policy_redrive P cw_lag_w ec2 T2'"
    unfolding T2'_def by (rule dwk_policy_redriveI[OF grd2 fin2])

  have base1: "dwk_base T1' = redrive_result (\<lambda>_. B) (dwk_base cw_del_w) ec2"
    unfolding T1'_def dwk_redrive_result_def B_def by simp
  have base2: "dwk_base T2' = redrive_result (\<lambda>_. B) (dwk_base cw_lag_w) ec2"
    unfolding T2'_def dwk_redrive_result_def PB2 by simp

  have em1: "dwe_emitted (dwk_base T1')
      = [(1, 0, ec1, e1), (2, 0, ec2, e2)] @ map (\<lambda>(c, e). (2, 0, c, e)) B"
    unfolding base1 redrive_result_def
    by (simp add: cw_del_w_def dp_crash_w_def mkW_def mkT_def mkC_def
                  eval_nat_numeral)
  have em2: "dwe_emitted (dwk_base T2')
      = [(1, 0, ec1, e1)] @ map (\<lambda>(c, e). (2, 0, c, e)) B"
    unfolding base2 redrive_result_def
    by (simp add: cw_lag_w_def t_mid_w_def mkW_def mkT_def mkC_def
                  eval_nat_numeral)
  have src2: "exec_src_hist (dwe_core (dwk_base T2')) = [(ec1, e1), (ec2, e2)]"
    unfolding base2 redrive_result_def
    by (simp add: cw_lag_w_def t_mid_w_def mkW_def mkT_def mkC_def)
  have scope2: "exec_scope (dwe_core (dwk_base T2')) = {0, 1}"
    unfolding base2 redrive_result_def
    by (simp add: cw_lag_w_def t_mid_w_def mkW_def mkT_def mkC_def)

  have pay1: "map e_payload (dwe_emitted (dwk_base T1'))
                = [(ec1, e1), (ec2, e2)] @ B"
    by (simp add: em1)

  \<comment> \<open>THE TWO TOTAL CASES on the shared batch B: does it mention an
      already-delivered payload of the delivered member, or not?\<close>
  have horn: "duplicate (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2')"
  proof (cases "\<exists>p \<in> set B. p \<in> {(ec1, e1), (ec2, e2)}")
    case True
    have "\<not> distinct (map e_payload (dwe_emitted (dwk_base T1')))"
      unfolding pay1 using True by auto
    then have "duplicate (dwk_base T1')"
      by (simp add: duplicate_def)
    then show ?thesis ..
  next
    case False
    have inrep: "(ec2, e2) \<in> set (replay_down_hist
                    (exec_src_hist (dwe_core (dwk_base T2')))
                    (exec_scope (dwe_core (dwk_base T2'))) ec2)"
      by (simp add: src2 scope2 replay_down_hist_def e1_def e2_def ec_defs
                    eval_nat_numeral)
    have notB: "(ec2, e2) \<notin> set B"
      using False by auto
    have notin: "(ec2, e2) \<notin> e_payload ` set (dwe_emitted (dwk_base T2'))"
      using notB by (auto simp: em2 e1_def e2_def ec_defs)
    have "lost_effect ec2 (dwk_base T2')"
      unfolding lost_effect_def using inrep notin by blast
    then show ?thesis ..
  qed

  have heal1: "\<forall>k. \<not> mismatch_at
                 (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k"
    by (rule dwk_policy_redrive_heals[OF pr1])
  have heal2: "\<forall>k. \<not> mismatch_at
                 (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k"
    by (rule dwk_policy_redrive_heals[OF pr2])

  show ?thesis using pr1 pr2 heal1 heal2 horn by blast
qed

text \<open>The class-defeat two-horn form, mirroring
  @{thm [source] checkpoint_dilemma_pair}: the ONE protocol-generated
  pair drives every durable-local-measured recovery --- the durable
  cursor included --- into duplicate-or-lost.\<close>

theorem checkpoint_duplicate_or_lost_pair:
  "\<exists>T1 T2.
     dwk_reachable T1 \<and> dwk_reachable T2
   \<and> durable_local_view T1 = durable_local_view T2
   \<and> dwk_cursor T1 = dwk_cursor T2
   \<and> dwe_emitted (dwk_base T1) \<noteq> dwe_emitted (dwk_base T2)
   \<and> \<not> effect_unsafe (dwk_base T1) \<and> \<not> effect_unsafe (dwk_base T2)
   \<and> genuinely_emitting (dwk_base T1) \<and> genuinely_emitting (dwk_base T2)
   \<and> (\<forall>P. durable_local_measured P \<longrightarrow>
        (\<exists>T1' T2'.
           dwk_policy_redrive P T1 ec2 T1'
         \<and> dwk_policy_redrive P T2 ec2 T2'
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
         \<and> (duplicate (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2'))))"
proof -
  have sm: "\<forall>P. durable_local_measured P \<longrightarrow>
        (\<exists>T1' T2'.
           dwk_policy_redrive P cw_del_w ec2 T1'
         \<and> dwk_policy_redrive P cw_lag_w ec2 T2'
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
         \<and> (duplicate (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2')))"
  proof (intro allI impI)
    fix P :: dwk_redrive_policy
    assume "durable_local_measured P"
    then obtain g where "\<forall>T. P T = g (durable_local_view T)"
      unfolding durable_local_measured_def by blast
    then have "P cw_del_w = P cw_lag_w"
      using pair_views_equal by metis
    then show "\<exists>T1' T2'.
           dwk_policy_redrive P cw_del_w ec2 T1'
         \<and> dwk_policy_redrive P cw_lag_w ec2 T2'
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T1')) ec2) ec2 k)
         \<and> (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T2')) ec2) ec2 k)
         \<and> (duplicate (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2'))"
      by (rule window_pair_duplicate_or_lost)
  qed
  show ?thesis
    using reach_cw_del reach_cw_lag pair_views_equal pair_cursors_equal
          pair_ledgers_differ cw_del_safe cw_lag_safe cw_del_emitting
          cw_lag_emitting sm
    by blast
qed

section \<open>The faithful recovery: inhabitation and the two horns\<close>

text \<open>
  The defeated class is inhabited by the machine's OWN recovery.
  @{text cursor_resume_policy} is the redrive-from-the-durable-cursor
  rule in policy form --- the landed cursor policy family with the free
  index @{term m} replaced by the state's cursor.  It factors through
  the durable-local view (it reads the cursor, the committed source and
  the scope --- nothing else), and the machine's recovery transition IS
  its policy redrive (@{text machine_recovery_is_cursor_policy}): the
  policy-level completion of the @{term m}-realization bridge.
\<close>

definition cursor_resume_policy :: "frontier \<Rightarrow> dwk_redrive_policy" where
  "cursor_resume_policy f T =
     drop (dwk_cursor T)
       (replay_down_hist (exec_src_hist (dwe_core (dwk_base T)))
          (exec_scope (dwe_core (dwk_base T))) f)"

lemma cursor_resume_policy_durable_local_measured:
  "durable_local_measured (cursor_resume_policy f)"
  unfolding durable_local_measured_def
  by (intro exI[of _ "\<lambda>v. drop (lv_cursor v)
                            (replay_down_hist (lv_src v) (lv_scope v) f)"])
     (simp add: cursor_resume_policy_def durable_local_view_def)

lemma machine_recovery_is_cursor_policy:
  assumes "dwk_move T (DWK_Reconcile f) T'"
  shows "dwk_policy_redrive (cursor_resume_policy f) T f T'"
proof -
  obtain B' where rec: "emitting_reconcile (dwk_cursor T) (dwk_base T) f B'"
      and T': "T' = T\<lparr>dwk_base := B'\<rparr>"
    using assms unfolding cursor_realizes_reconcile_index by blast
  have "policy_redrive (\<lambda>_. cursor_resume_policy f T) (dwk_base T) f B'"
    using rec
    by (simp add: emitting_reconcile_def policy_redrive_def
                  cursor_resume_policy_def)
  then show ?thesis
    unfolding dwk_policy_redrive_def T' by simp
qed

text \<open>
  The two horns, realized concretely by the machine's own parameter-free
  recovery transition.  From the two view-indistinguishable members the
  SAME recovery --- redrive from the durable cursor, @{term "m = 1"}
  read off the state --- is exactly right on the lag member (heals, stays
  effect-safe, loses nothing: its result state's base is the banked
  @{const t_safe_w})
  and produces an effect-unsafe DUPLICATE on the delivered member, every
  entry of the duplicated ledger individually justified (duplication is
  orthogonal to justification).  This is the at-least-once window as a
  pair of machine transitions.
\<close>

definition dp_dup_w :: "(nat, nat) dwe_state" where
  "dp_dup_w = mkT (mkC [(ec1, e1), (ec2, e2)] [(ec1, e1), (ec2, e2)]
                     [(ec1, e1), (ec2, e2)] {} Recovered)
                  [(1, 0, ec1, e1), (2, 0, ec2, e2), (2, 0, ec2, e2)] 0"

lemma rec_cw_del: "emitting_reconcile 1 dp_crash_w ec2 dp_dup_w"
  by (simp add: emitting_reconcile_def dp_crash_w_def dp_dup_w_def
                mkT_def mkC_def replay_down_hist_def e1_def e2_def ec_defs
                eval_nat_numeral)

lemma dwk_rec_del: "dwk_move cw_del_w (DWK_Reconcile ec2) (mkW dp_dup_w 1)"
  unfolding cw_del_w_def
  by (rule mkW_move_reconcileI[OF rec_cw_del])

lemma dwk_rec_lag: "dwk_move cw_lag_w (DWK_Reconcile ec2) (mkW t_safe_w 1)"
  unfolding cw_lag_w_def
  by (rule mkW_move_reconcileI[OF rec_safe])

lemma dp_dup_unsafe: "effect_unsafe dp_dup_w"
  by (simp add: effect_unsafe_def duplicate_def dp_dup_w_def mkT_def
                e1_def e2_def ec_defs)

lemma dp_dup_justified:
  "\<forall>x \<in> set (dwe_emitted dp_dup_w).
     justified_at (exec_src_hist (dwe_core dp_dup_w)) x"
  by (simp add: dp_dup_w_def mkT_def mkC_def justified_at_def
                e1_def e2_def ec_defs eval_nat_numeral)

lemma t_safe_no_loss: "\<not> lost_effect ec2 t_safe_w"
  by (simp add: lost_effect_def t_safe_w_def mkT_def mkC_def
                replay_down_hist_def e1_def e2_def ec_defs eval_nat_numeral)

theorem faithful_recovery_window_horns:
  "dwk_move cw_del_w (DWK_Reconcile ec2) (mkW dp_dup_w 1)
 \<and> dwk_move cw_lag_w (DWK_Reconcile ec2) (mkW t_safe_w 1)
 \<and> durable_local_view cw_del_w = durable_local_view cw_lag_w
 \<and> effect_unsafe dp_dup_w
 \<and> (\<forall>x \<in> set (dwe_emitted dp_dup_w).
      justified_at (exec_src_hist (dwe_core dp_dup_w)) x)
 \<and> \<not> effect_unsafe t_safe_w
 \<and> \<not> lost_effect ec2 t_safe_w
 \<and> (\<forall>k. \<not> mismatch_at (proto_of_exec_at (dwe_core dp_dup_w) ec2) ec2 k)
 \<and> (\<forall>k. \<not> mismatch_at (proto_of_exec_at (dwe_core t_safe_w) ec2) ec2 k)"
  by (intro conjI dwk_rec_del dwk_rec_lag pair_views_equal dp_dup_unsafe
        dp_dup_justified t_safe_not_unsafe t_safe_no_loss
        emitting_reconcile_heals[OF rec_cw_del] t_safe_heal)

text \<open>The policy form agrees on the pair (its inputs --- cursor, source,
  scope --- are view components), so the exported kernel defeats it; the
  defeat instance is banked as a corollary.\<close>

lemma cursor_resume_agrees_on_pair:
  "cursor_resume_policy ec2 cw_del_w = cursor_resume_policy ec2 cw_lag_w"
  by (simp add: cursor_resume_policy_def cw_del_w_def cw_lag_w_def
                dp_crash_w_def t_mid_w_def mkW_def mkT_def mkC_def)

corollary cursor_resume_policy_defeated:
  "\<exists>T1' T2'.
     dwk_policy_redrive (cursor_resume_policy ec2) cw_del_w ec2 T1'
   \<and> dwk_policy_redrive (cursor_resume_policy ec2) cw_lag_w ec2 T2'
   \<and> (effect_unsafe (dwk_base T1') \<or> lost_effect ec2 (dwk_base T2'))"
  using window_pair_batch_agreement_defeated[OF cursor_resume_agrees_on_pair]
  by blast

section \<open>The dichotomy bridge: the sink-reading escape distinguishes\<close>

text \<open>
  The landed sink-reading policy, lifted pointwise to the wrapper.  On
  the window pair it computes the empty batch on the delivered member
  and the missing second effect on the lag member --- it DISTINGUISHES
  the pair, hence is provably not durable-local-measured: the escape
  does not satisfy the kernel's agreement premise, and the durable
  cursor does not subsume it.  Its guarantees at both members are cited
  from the landed premise-free general form
  (@{thm [source] sink_reading_escape_general}): from either member the
  redrive exists, heals every scoped mismatch at the frontier, stays
  effect-safe, and loses nothing --- the ascending-source premise is
  discharged at the pair's concrete committed source.
\<close>

definition dwk_sink_delta :: "frontier \<Rightarrow> dwk_redrive_policy" where
  "dwk_sink_delta f T = sink_delta f (dwk_base T)"

lemma sink_delta_separates_pair:
  "dwk_sink_delta ec2 cw_del_w = []"
  "dwk_sink_delta ec2 cw_lag_w = [(ec2, e2)]"
  by (simp_all add: dwk_sink_delta_def sink_delta_def cw_del_w_def
                    cw_lag_w_def dp_crash_w_def t_mid_w_def mkW_def
                    mkT_def mkC_def replay_down_hist_def e1_def e2_def
                    ec_defs)

theorem sink_delta_not_durable_local_measured:
  "\<not> durable_local_measured (dwk_sink_delta ec2)"
proof
  assume "durable_local_measured (dwk_sink_delta ec2)"
  then obtain g where g: "\<forall>T. dwk_sink_delta ec2 T = g (durable_local_view T)"
    unfolding durable_local_measured_def by blast
  have "dwk_sink_delta ec2 cw_del_w = dwk_sink_delta ec2 cw_lag_w"
    using g pair_views_equal by metis
  then show False
    by (simp add: sink_delta_separates_pair)
qed

lemma pair_src_asc:
  "strictly_ascending_source (exec_src_hist (dwe_core (dwk_base cw_del_w)))"
  "strictly_ascending_source (exec_src_hist (dwe_core (dwk_base cw_lag_w)))"
  by (simp_all add: strictly_ascending_source_def cw_del_w_def cw_lag_w_def
                    dp_crash_w_def t_mid_w_def mkW_def mkT_def mkC_def
                    e1_def e2_def ec_defs)

lemma dwk_sink_delta_escape_at:
  assumes safe: "\<not> effect_unsafe (dwk_base T)"
      and crashed: "\<exists>c. exec_status (dwe_core (dwk_base T)) = Crashed c"
      and fin: "ec2 \<le> exec_finish (dwe_core (dwk_base T))"
      and asc: "strictly_ascending_source (exec_src_hist (dwe_core (dwk_base T)))"
  shows "(\<exists>T'. dwk_policy_redrive (dwk_sink_delta ec2) T ec2 T')
       \<and> (\<forall>T'. dwk_policy_redrive (dwk_sink_delta ec2) T ec2 T' \<longrightarrow>
            (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
          \<and> \<not> effect_unsafe (dwk_base T')
          \<and> \<not> lost_effect ec2 (dwk_base T'))"
proof (rule conjI)
  show "\<exists>T'. dwk_policy_redrive (dwk_sink_delta ec2) T ec2 T'"
    using dwk_policy_redriveI[OF crashed fin] by blast
next
  have gen: "\<forall>t'. policy_redrive (sink_delta ec2) (dwk_base T) ec2 t' \<longrightarrow>
          (\<forall>k. \<not> mismatch_at (proto_of_exec_at (dwe_core t') ec2) ec2 k)
        \<and> \<not> effect_unsafe t' \<and> \<not> lost_effect ec2 t'"
    using sink_reading_escape_general[OF safe crashed fin asc] by blast
  show "\<forall>T'. dwk_policy_redrive (dwk_sink_delta ec2) T ec2 T' \<longrightarrow>
            (\<forall>k. \<not> mismatch_at
                    (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
          \<and> \<not> effect_unsafe (dwk_base T')
          \<and> \<not> lost_effect ec2 (dwk_base T')"
  proof (intro allI impI)
    fix T'
    assume "dwk_policy_redrive (dwk_sink_delta ec2) T ec2 T'"
    then have "policy_redrive (\<lambda>_. dwk_sink_delta ec2 T)
                 (dwk_base T) ec2 (dwk_base T')"
      by (rule dwk_policy_redrive_base)
    then have "policy_redrive (sink_delta ec2) (dwk_base T) ec2 (dwk_base T')"
      using policy_redrive_batch_cong[of "sink_delta ec2" "dwk_base T"
              "\<lambda>_. dwk_sink_delta ec2 T"]
      by (simp add: dwk_sink_delta_def)
    then show "(\<forall>k. \<not> mismatch_at
                      (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
             \<and> \<not> effect_unsafe (dwk_base T')
             \<and> \<not> lost_effect ec2 (dwk_base T')"
      using gen by blast
  qed
qed

theorem sink_delta_escapes_at_pair:
  "((\<exists>T'. dwk_policy_redrive (dwk_sink_delta ec2) cw_del_w ec2 T')
   \<and> (\<forall>T'. dwk_policy_redrive (dwk_sink_delta ec2) cw_del_w ec2 T' \<longrightarrow>
        (\<forall>k. \<not> mismatch_at
                (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
      \<and> \<not> effect_unsafe (dwk_base T')
      \<and> \<not> lost_effect ec2 (dwk_base T')))
 \<and> ((\<exists>T'. dwk_policy_redrive (dwk_sink_delta ec2) cw_lag_w ec2 T')
   \<and> (\<forall>T'. dwk_policy_redrive (dwk_sink_delta ec2) cw_lag_w ec2 T' \<longrightarrow>
        (\<forall>k. \<not> mismatch_at
                (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
      \<and> \<not> effect_unsafe (dwk_base T')
      \<and> \<not> lost_effect ec2 (dwk_base T')))"
proof (rule conjI)
  show "(\<exists>T'. dwk_policy_redrive (dwk_sink_delta ec2) cw_del_w ec2 T')
      \<and> (\<forall>T'. dwk_policy_redrive (dwk_sink_delta ec2) cw_del_w ec2 T' \<longrightarrow>
           (\<forall>k. \<not> mismatch_at
                   (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
         \<and> \<not> effect_unsafe (dwk_base T')
         \<and> \<not> lost_effect ec2 (dwk_base T'))"
    by (rule dwk_sink_delta_escape_at[OF cw_del_safe _ _ pair_src_asc(1)])
       (simp_all add: cw_del_fields)
next
  show "(\<exists>T'. dwk_policy_redrive (dwk_sink_delta ec2) cw_lag_w ec2 T')
      \<and> (\<forall>T'. dwk_policy_redrive (dwk_sink_delta ec2) cw_lag_w ec2 T' \<longrightarrow>
           (\<forall>k. \<not> mismatch_at
                   (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
         \<and> \<not> effect_unsafe (dwk_base T')
         \<and> \<not> lost_effect ec2 (dwk_base T'))"
    by (rule dwk_sink_delta_escape_at[OF cw_lag_safe _ _ pair_src_asc(2)])
       (simp_all add: cw_lag_fields)
qed

section \<open>Pricing the carve: the two excluded local shadows\<close>

text \<open>
  The two probe controls certify that the view's exclusions are
  load-bearing, each in the honest direction.  The delivered material's
  only traces at the pair are sink-side or volatile: a policy reading
  the downstream store content (the content-idempotent downstream
  reading --- the delta against what the downstream already holds)
  distinguishes the pair, exactly as the ledger-reading escape does ---
  reading the downstream content IS reading the sink, and it sits on
  the escape side of the dichotomy.  A policy probing the crashed
  process's in-flight pending window also distinguishes the pair; the
  view excludes that window as volatile (the landed reconcile always
  discards it; the landed core-tier truncation theory does not lose it
  but reconstructs it at a durable boundary as durable enqueued minus
  durable delivered --- a reconstruction that itself reads the excluded
  downstream content), which is disclosed rather than hidden.  The two
  probe controls claim only separation; the adopted control below prices
  the carve in the strong direction as well --- the pending reader is a
  full escape.
\<close>

definition content_delta_policy :: "frontier \<Rightarrow> dwk_redrive_policy" where
  "content_delta_policy f T =
     filter (\<lambda>p. p \<notin> set (exec_down_hist (dwe_core (dwk_base T))))
       (replay_down_hist (exec_src_hist (dwe_core (dwk_base T)))
          (exec_scope (dwe_core (dwk_base T))) f)"

lemma content_delta_separates_pair:
  "content_delta_policy ec2 cw_del_w = []"
  "content_delta_policy ec2 cw_lag_w = [(ec2, e2)]"
  by (simp_all add: content_delta_policy_def cw_del_w_def cw_lag_w_def
                    dp_crash_w_def t_mid_w_def mkW_def mkT_def mkC_def
                    replay_down_hist_def e1_def e2_def ec_defs)

lemma content_delta_not_durable_local_measured:
  "\<not> durable_local_measured (content_delta_policy ec2)"
proof
  assume "durable_local_measured (content_delta_policy ec2)"
  then obtain g where
    g: "\<forall>T. content_delta_policy ec2 T = g (durable_local_view T)"
    unfolding durable_local_measured_def by blast
  have "content_delta_policy ec2 cw_del_w = content_delta_policy ec2 cw_lag_w"
    using g pair_views_equal by metis
  then show False
    by (simp add: content_delta_separates_pair)
qed

definition pending_probe_policy :: "dwk_redrive_policy" where
  "pending_probe_policy T =
     (if exec_pending (dwe_core (dwk_base T)) = {} then [] else [(ec1, e1)])"

lemma pending_probe_separates_pair:
  "pending_probe_policy cw_del_w = []"
  "pending_probe_policy cw_lag_w = [(ec1, e1)]"
  by (simp_all add: pending_probe_policy_def cw_del_w_def cw_lag_w_def
                    dp_crash_w_def t_mid_w_def mkW_def mkT_def mkC_def)

lemma pending_probe_not_durable_local_measured:
  "\<not> durable_local_measured pending_probe_policy"
proof
  assume "durable_local_measured pending_probe_policy"
  then obtain g where
    g: "\<forall>T. pending_probe_policy T = g (durable_local_view T)"
    unfolding durable_local_measured_def by blast
  have "pending_probe_policy cw_del_w = pending_probe_policy cw_lag_w"
    using g pair_views_equal by metis
  then show False
    by (simp add: pending_probe_separates_pair)
qed

subsection \<open>The adopted full-escape control: the pending reader rescues\<close>

text \<open>
  Adopted from an adversarial review lane of the 2026-07-31 fleet,
  verbatim up to lemma renaming.  The pending-window reader is not
  merely a separator: a policy reading ONLY the crashed process's
  in-flight pending window --- the volatile field the view excludes,
  which the machine's own status-flip crash formally preserves ---
  separates the pair AND recovers exactly right on BOTH members: its
  redrive exists, heals every scoped mismatch at the frontier, stays
  effect-safe, and loses nothing; on the lag member its result base is
  literally the banked @{const t_safe_w}.  This is the strong-direction
  price of the carve: if the in-memory window survived real crashes,
  the dilemma would dissolve --- which is exactly why its volatility is
  the modelling premise, and why the machine's own recovery (the cyclic
  reconcile at the cursor) discards rather than reads it.
\<close>

definition pending_read_policy :: dwk_redrive_policy where
  "pending_read_policy T =
     (if exec_pending (dwe_core (dwk_base T)) = {} then [] else [(ec2, e2)])"

lemma pending_read_separates:
  "pending_read_policy cw_del_w = []"
  "pending_read_policy cw_lag_w = [(ec2, e2)]"
  by (simp_all add: pending_read_policy_def cw_del_w_def cw_lag_w_def
                    dp_crash_w_def t_mid_w_def mkW_def mkT_def mkC_def)

lemma pending_read_not_durable_local_measured:
  "\<not> durable_local_measured pending_read_policy"
proof
  assume "durable_local_measured pending_read_policy"
  then obtain g where g: "\<forall>T. pending_read_policy T = g (durable_local_view T)"
    unfolding durable_local_measured_def by blast
  have "pending_read_policy cw_del_w = pending_read_policy cw_lag_w"
    using g pair_views_equal by metis
  then show False by (simp add: pending_read_separates e1_def e2_def)
qed

text \<open>The two result states, computed.\<close>

lemma pending_read_result_del:
  "dwk_base (dwk_redrive_result pending_read_policy cw_del_w ec2)
     = mkT (mkC [(ec1, e1), (ec2, e2)] [(ec1, e1), (ec2, e2)]
              [(ec1, e1), (ec2, e2)] {} Recovered)
           [(1, 0, ec1, e1), (2, 0, ec2, e2)] 0"
proof -
  have "dwk_base (dwk_redrive_result pending_read_policy cw_del_w ec2)
          = redrive_result (\<lambda>_. []) (dwk_base cw_del_w) ec2"
    by (simp only: dwk_redrive_result_def mkW_base pending_read_separates)
  then show ?thesis
    by (simp add: redrive_result_def cw_del_w_def dp_crash_w_def mkW_def
                  mkT_def mkC_def replay_down_hist_def e1_def e2_def ec_defs)
qed

lemma pending_read_result_lag:
  "dwk_base (dwk_redrive_result pending_read_policy cw_lag_w ec2) = t_safe_w"
proof -
  have "dwk_base (dwk_redrive_result pending_read_policy cw_lag_w ec2)
          = redrive_result (\<lambda>_. [(ec2, e2)]) (dwk_base cw_lag_w) ec2"
    by (simp only: dwk_redrive_result_def mkW_base pending_read_separates)
  then show ?thesis
    by (simp add: redrive_result_def cw_lag_w_def t_mid_w_def t_safe_w_def
                  mkW_def mkT_def mkC_def replay_down_hist_def e1_def e2_def
                  ec_defs eval_nat_numeral)
qed

lemma pending_read_del_safe:
  "\<not> effect_unsafe (dwk_base (dwk_redrive_result pending_read_policy cw_del_w ec2))"
  unfolding pending_read_result_del
  by (simp add: effect_unsafe_def premature_def duplicate_def
                justified_at_def mkT_def mkC_def e1_def e2_def ec_defs
                eval_nat_numeral)

lemma pending_read_del_no_loss:
  "\<not> lost_effect ec2 (dwk_base (dwk_redrive_result pending_read_policy cw_del_w ec2))"
  unfolding pending_read_result_del
  by (simp add: lost_effect_def mkT_def mkC_def replay_down_hist_def
                e1_def e2_def ec_defs eval_nat_numeral)

lemma pending_read_lag_safe:
  "\<not> effect_unsafe (dwk_base (dwk_redrive_result pending_read_policy cw_lag_w ec2))"
  unfolding pending_read_result_lag by (rule t_safe_not_unsafe)

lemma pending_read_lag_no_loss:
  "\<not> lost_effect ec2 (dwk_base (dwk_redrive_result pending_read_policy cw_lag_w ec2))"
  unfolding pending_read_result_lag by (rule t_safe_no_loss)

text \<open>THE CONTROL VERDICT: the pending-reading recovery exists at both
  members, heals both, and is effect-safe and loss-free at BOTH --- it
  escapes the checkpoint dilemma while reading nothing but the crashed
  process's own (volatile) local state.\<close>

theorem pending_read_escapes_the_window_pair:
  "\<not> durable_local_measured pending_read_policy
 \<and> (\<exists>T'. dwk_policy_redrive pending_read_policy cw_del_w ec2 T')
 \<and> (\<exists>T'. dwk_policy_redrive pending_read_policy cw_lag_w ec2 T')
 \<and> (\<forall>T'. dwk_policy_redrive pending_read_policy cw_del_w ec2 T' \<longrightarrow>
      (\<forall>k. \<not> mismatch_at (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
    \<and> \<not> effect_unsafe (dwk_base T') \<and> \<not> lost_effect ec2 (dwk_base T'))
 \<and> (\<forall>T'. dwk_policy_redrive pending_read_policy cw_lag_w ec2 T' \<longrightarrow>
      (\<forall>k. \<not> mismatch_at (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
    \<and> \<not> effect_unsafe (dwk_base T') \<and> \<not> lost_effect ec2 (dwk_base T'))"
proof -
  have grd1: "\<exists>c. exec_status (dwe_core (dwk_base cw_del_w)) = Crashed c"
    by (simp add: cw_del_fields)
  have grd2: "\<exists>c. exec_status (dwe_core (dwk_base cw_lag_w)) = Crashed c"
    by (simp add: cw_lag_fields)
  have fin1: "ec2 \<le> exec_finish (dwe_core (dwk_base cw_del_w))"
    by (simp add: cw_del_fields)
  have fin2: "ec2 \<le> exec_finish (dwe_core (dwk_base cw_lag_w))"
    by (simp add: cw_lag_fields)
  have ex1: "dwk_policy_redrive pending_read_policy cw_del_w ec2
              (dwk_redrive_result pending_read_policy cw_del_w ec2)"
    by (rule dwk_policy_redriveI[OF grd1 fin1])
  have ex2: "dwk_policy_redrive pending_read_policy cw_lag_w ec2
              (dwk_redrive_result pending_read_policy cw_lag_w ec2)"
    by (rule dwk_policy_redriveI[OF grd2 fin2])
  have u1: "\<forall>T'. dwk_policy_redrive pending_read_policy cw_del_w ec2 T' \<longrightarrow>
      (\<forall>k. \<not> mismatch_at (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
    \<and> \<not> effect_unsafe (dwk_base T') \<and> \<not> lost_effect ec2 (dwk_base T')"
  proof (intro allI impI)
    fix T' assume a: "dwk_policy_redrive pending_read_policy cw_del_w ec2 T'"
    have eq: "T' = dwk_redrive_result pending_read_policy cw_del_w ec2"
      by (rule dwk_policy_redrive_unique[OF a])
    show "(\<forall>k. \<not> mismatch_at (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
        \<and> \<not> effect_unsafe (dwk_base T') \<and> \<not> lost_effect ec2 (dwk_base T')"
      using dwk_policy_redrive_heals[OF a] pending_read_del_safe
            pending_read_del_no_loss
      by (simp add: eq)
  qed
  have u2: "\<forall>T'. dwk_policy_redrive pending_read_policy cw_lag_w ec2 T' \<longrightarrow>
      (\<forall>k. \<not> mismatch_at (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
    \<and> \<not> effect_unsafe (dwk_base T') \<and> \<not> lost_effect ec2 (dwk_base T')"
  proof (intro allI impI)
    fix T' assume a: "dwk_policy_redrive pending_read_policy cw_lag_w ec2 T'"
    have eq: "T' = dwk_redrive_result pending_read_policy cw_lag_w ec2"
      by (rule dwk_policy_redrive_unique[OF a])
    show "(\<forall>k. \<not> mismatch_at (proto_of_exec_at (dwe_core (dwk_base T')) ec2) ec2 k)
        \<and> \<not> effect_unsafe (dwk_base T') \<and> \<not> lost_effect ec2 (dwk_base T')"
      using dwk_policy_redrive_heals[OF a] pending_read_lag_safe
            pending_read_lag_no_loss
      by (simp add: eq)
  qed
  show ?thesis
    using pending_read_not_durable_local_measured ex1 ex2 u1 u2 by blast
qed

section \<open>The exhaustive dichotomy\<close>

text \<open>
  Literally exhaustive over all re-drive policies of the cursor machine:
  every policy either factors through the durable-local view --- the
  class the checkpoint dilemma defeats on the protocol-generated pair
  --- or its batch distinguishes two states that agree on that ENTIRE
  view and hence differ only in the downstream store content, the
  volatile in-flight window, or the emission ledger: it reads beyond
  the consumer's durable-local state.  Both branches are inhabited:
  the machine's own cursor-resume recovery is measured; the landed
  sink-reading escape (and the downstream content reading) distinguish.
\<close>

theorem checkpoint_recovery_dichotomy:
  fixes P :: dwk_redrive_policy
  shows "durable_local_measured P
       \<or> (\<exists>T U. durable_local_view T = durable_local_view U
              \<and> (exec_down_hist (dwe_core (dwk_base T))
                   \<noteq> exec_down_hist (dwe_core (dwk_base U))
                 \<or> exec_pending (dwe_core (dwk_base T))
                     \<noteq> exec_pending (dwe_core (dwk_base U))
                 \<or> dwe_emitted (dwk_base T) \<noteq> dwe_emitted (dwk_base U))
              \<and> P T \<noteq> P U)"
proof (cases "view_blind P")
  case True
  then show ?thesis
    by (simp add: view_blind_iff_durable_local_measured)
next
  case False
  then obtain T U where veq: "durable_local_view T = durable_local_view U"
      and pneq: "P T \<noteq> P U"
    unfolding view_blind_def by blast
  have "exec_down_hist (dwe_core (dwk_base T))
          \<noteq> exec_down_hist (dwe_core (dwk_base U))
      \<or> exec_pending (dwe_core (dwk_base T))
          \<noteq> exec_pending (dwe_core (dwk_base U))
      \<or> dwe_emitted (dwk_base T) \<noteq> dwe_emitted (dwk_base U)"
  proof (rule ccontr)
    assume "\<not> (exec_down_hist (dwe_core (dwk_base T))
                 \<noteq> exec_down_hist (dwe_core (dwk_base U))
             \<or> exec_pending (dwe_core (dwk_base T))
                 \<noteq> exec_pending (dwe_core (dwk_base U))
             \<or> dwe_emitted (dwk_base T) \<noteq> dwe_emitted (dwk_base U))"
    then have "T = U"
      using veq by (intro dwk_state_view_ext) auto
    with pneq show False by simp
  qed
  with veq pneq show ?thesis by blast
qed

section \<open>The window control: outside the window the cursor tells the truth\<close>

text \<open>
  Crashing AFTER the final persist (schedule Go to the end, then crash)
  reaches @{const cw_done_w}: the same crashed base as the delivered
  member, with cursor 2.  Its durable-local view differs from BOTH pair
  members at the cursor component alone --- once the persist lands, the
  cursor itself separates the state from the window pair.  The
  confusion is the deliver-to-persist window's own making: a crash
  inside it (the delivered member) is view-indistinguishable from one
  just before the delivery (the lag member), and once the persist
  closes the window the cursor tells the truth --- the dilemma is the
  window, not the cursor's bookkeeping.
\<close>

theorem post_persist_cursor_separates:
  "dwk_protocol_run (dwk_init Map.empty {0, 1} ec2) sched_complete cw_done_w
 \<and> dwk_cursor cw_done_w = 2
 \<and> dwk_cursor cw_del_w = 1
 \<and> dwk_cursor cw_lag_w = 1
 \<and> durable_local_view cw_done_w \<noteq> durable_local_view cw_del_w
 \<and> durable_local_view cw_done_w \<noteq> durable_local_view cw_lag_w"
proof -
  have c_done: "dwk_cursor cw_done_w = 2"
    by (simp add: cw_done_w_def)
  have v1: "durable_local_view cw_done_w \<noteq> durable_local_view cw_del_w"
  proof
    assume "durable_local_view cw_done_w = durable_local_view cw_del_w"
    then have "dwk_cursor cw_done_w = dwk_cursor cw_del_w"
      unfolding durable_local_view_def by simp
    then show False by (simp add: c_done cw_del_fields)
  qed
  have v2: "durable_local_view cw_done_w \<noteq> durable_local_view cw_lag_w"
  proof
    assume "durable_local_view cw_done_w = durable_local_view cw_lag_w"
    then have "dwk_cursor cw_done_w = dwk_cursor cw_lag_w"
      unfolding durable_local_view_def by simp
    then show False by (simp add: c_done cw_lag_fields)
  qed
  show ?thesis
    by (intro conjI protocol_run_complete v1 v2)
       (simp_all add: cw_done_w_def cw_del_fields cw_lag_fields)
qed

