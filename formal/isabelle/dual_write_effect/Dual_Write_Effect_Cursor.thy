  have s6: "dwk_protocol_run pr6_w [Sched_Crash] cw_lag_w"
    by (rule dwk_protocol_run.run_crash[OF cm_lag s7])
  have s5: "dwk_protocol_run pr5_w [Sched_Go, Sched_Crash] cw_lag_w"
    by (rule dwk_protocol_run.run_go[OF pn5 pm6 s6])
  have s4: "dwk_protocol_run pr4_w
              [Sched_Go, Sched_Go, Sched_Crash] cw_lag_w"
    by (rule dwk_protocol_run.run_go[OF pn4 pm5 s5])
